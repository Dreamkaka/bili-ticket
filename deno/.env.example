# Deno serverless 探针环境变量示例（复制为 .env.local 供 npm task dev 使用）
# Deno Deploy 上请在项目 Settings → Environment Variables 配置同名变量

# Gateway 根地址。Deno Deploy 无法访问集群内 ClusterIP，须为公网 HTTPS
GATEWAY_HTTP_URL=http://127.0.0.1:3000

# 与 gateway / probe / worker 必须一致的共享密钥；网关未配置时留空
PROBE_TOKEN=

# 节点名，会显示在 /api/nodes
NODE_NAME=deno-probe

# 等级：primary=与 Go 主探针同级；monitor=辅助监测
ROLE=primary
# 传输方式，serverless 固定 http
TRANSPORT=http

PROBE_USER_AGENT=
# B 站登录 cookie SESSDATA，可选，降低风控
SESSDATA=

# 冷启动种子（可选，逗号分隔），减少对 gateway /api/probe/targets 的依赖
CORE_IDS=
SHARD_IDS=

# 目标列表缓存秒数，默认 3600
TARGETS_TTL_SEC=3600
# 无 diff 时每 N 次 Cron 报一次心跳。默认 1（每分钟心跳，保证 /api/nodes 在线）
HEARTBEAT_EVERY_N_RUNS=1
# getV2 并发，默认 3
MAX_CONCURRENCY=3
